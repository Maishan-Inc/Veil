{
  "name": "veil",
  "version": "0.1.0",
  "private": true,
  "description": "Veil — offline, local-first, open-source browser manager.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.4.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter @veil/desktop tauri dev",
    "desktop:dev": "pnpm --filter @veil/desktop tauri dev",
    "desktop:build": "pnpm --filter @veil/desktop tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  }
}
